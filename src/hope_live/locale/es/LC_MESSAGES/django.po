#: src/hope_live/web/chart_metadata.py:75
#: src/hope_live/web/chart_metadata.py:84
#: src/hope_live/web/chart_metadata.py:93
#: src/hope_live/web/chart_metadata.py:115
msgid "HOPE payments — country report financial feed."
